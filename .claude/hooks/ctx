#!/usr/bin/env python3
"""Launcher for the `ctx` CLI: `python3 .claude/hooks/ctx read FILE`.

Adds this directory to sys.path so the package works from any cwd and without
installation. Symlink it into ~/.local/bin/ctx to type plain `ctx`.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from token_saver.ctx import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
