#!/usr/bin/env python3
"""Launcher for the Claude Code hooks: `token-saver-hook pre-bash` etc.

Reads the hook event JSON on stdin. Always exits 0: the only way it influences
a session is the optional JSON decision it prints.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from token_saver.hook import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
